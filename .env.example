# Строка подключения к Postgres.
# У Neon берите вариант с суффиксом -pooler в имени хоста — обычное
# подключение быстро упирается в лимит соединений serverless-функций.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Ключ подписи сессий админки. Не меньше 32 символов, свой и секретный.
# Сгенерировать:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Необязательно. Появляется сам, если в проекте Vercel подключить
# хранилище Blob. Пока переменной нет, картинки хранятся в базе.
# BLOB_READ_WRITE_TOKEN=
